{
  "expo": {
    "name": "Dark Mat",
    "slug": "dark-mat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "darkmat",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.darkmat.app",
      "infoPlist": {
        "UIBackgroundModes": [],
        "NSCameraUsageDescription": "Dark Mat uses the camera so you can set a profile photo.",
        "NSPhotoLibraryUsageDescription": "Dark Mat uses your photo library so you can set a profile photo.",
        "NSLocationWhenInUseUsageDescription": "Dark Mat uses your location to find nearby BJJ seminars and tournaments."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.darkmat.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0D0D",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Dark Mat to access your photos for a profile picture.",
          "cameraPermission": "Allow Dark Mat to use the camera for a profile picture."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Dark Mat to use your location to find nearby BJJ seminars and tournaments."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.darkmat.app",
          "enableGooglePay": true
        }
      ]
    ]
  }
}
