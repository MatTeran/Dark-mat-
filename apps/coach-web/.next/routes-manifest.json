{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/members/[memberId]",
      "regex": "^/members/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPmemberId": "nxtPmemberId"
      },
      "namedRegex": "^/members/(?<nxtPmemberId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/members/[memberId]/add-stripe",
      "regex": "^/members/([^/]+?)/add\\-stripe(?:/)?$",
      "routeKeys": {
        "nxtPmemberId": "nxtPmemberId"
      },
      "namedRegex": "^/members/(?<nxtPmemberId>[^/]+?)/add\\-stripe(?:/)?$"
    },
    {
      "page": "/members/[memberId]/promote-belt",
      "regex": "^/members/([^/]+?)/promote\\-belt(?:/)?$",
      "routeKeys": {
        "nxtPmemberId": "nxtPmemberId"
      },
      "namedRegex": "^/members/(?<nxtPmemberId>[^/]+?)/promote\\-belt(?:/)?$"
    },
    {
      "page": "/schedule/[classId]",
      "regex": "^/schedule/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPclassId": "nxtPclassId"
      },
      "namedRegex": "^/schedule/(?<nxtPclassId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/schedule/[classId]/edit",
      "regex": "^/schedule/([^/]+?)/edit(?:/)?$",
      "routeKeys": {
        "nxtPclassId": "nxtPclassId"
      },
      "namedRegex": "^/schedule/(?<nxtPclassId>[^/]+?)/edit(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/announcements",
      "regex": "^/announcements(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/announcements(?:/)?$"
    },
    {
      "page": "/announcements/new",
      "regex": "^/announcements/new(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/announcements/new(?:/)?$"
    },
    {
      "page": "/check-in",
      "regex": "^/check\\-in(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/check\\-in(?:/)?$"
    },
    {
      "page": "/command-center",
      "regex": "^/command\\-center(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/command\\-center(?:/)?$"
    },
    {
      "page": "/development",
      "regex": "^/development(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/development(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/members",
      "regex": "^/members(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/members(?:/)?$"
    },
    {
      "page": "/schedule",
      "regex": "^/schedule(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/schedule(?:/)?$"
    },
    {
      "page": "/schedule/new",
      "regex": "^/schedule/new(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/schedule/new(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}